# Google Cloud
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true

# Choose a Gemini Flash model available in your project.
GEMINI_MODEL=gemini-2.5-flash

# Parallel Web Systems
PARALLEL_API_KEY=replace-with-your-key

# Emergency local demonstration only. Keep false for normal production use.
ALLOW_PARALLEL_DEMO_FALLBACK=false

# Product safeguards
MAX_UPLOAD_MB=20
MAX_REFERENCES=8
MAX_SEARCH_RESULTS=5
